# .env configuration file for Sigma Signed-url method

# For details on embedding requirements, visit:
# https://help.sigmacomputing.com/docs/embed-url-parameters

# Required Embed Configuration
EMBED_PATH=your_sigma_url_to_embed
CLIENT_ID=your_client_id
SECRET=your_secret


# Optional Embed Configuration
SESSION_LENGTH=3600

# User-Specific Parameters
EMAIL=client_a@client_a.com
#EMAIL=client_b@client_b.com
EXTERNAL_USER_TEAM=Client_A
#EXTERNAL_USER_TEAM=Client_B
EXTERNAL_USER_ID=123
ACCOUNT_TYPE=View
MODE=userbacked

# Server Configuration
PORT=3000

#Client A Connection
eval_connection_id=your_connection_id
#Client B Connection
#eval_connection_id=your_connection_id