# .env configuration file for Sigma Embed API QuickStart Series
# -----------------------------------------------------------------------------
# ⚙️  Shared Settings
# These values apply to ALL QuickStarts unless overridden in code or future env vars.
# -----------------------------------------------------------------------------

SESSION_LENGTH=3600
PORT=3000

# Sigma OAuth Credentials (Client Credentials Grant)
AUTH_URL=https://app.sigmacomputing.com/oauth/token
CLIENT_ID=REDACTED
SECRET=REDACTED

# -----------------------------------------------------------------------------
# 👤 Impersonation Member IDs (used across all QuickStarts)
# Replace with valid memberId values from your Sigma instance.
# -----------------------------------------------------------------------------

ADMIN_MEMBER_ID=yRn1UFV8ngVWBM1Hgrl51h7MS8uow
BUILD_MEMBER_ID=22222222-bbbb-cccc-dddd-2345678901bc
VIEW_MEMBER_ID=33333333-cccc-dddd-eeee-3456789012cd


# -----------------------------------------------------------------------------
# 🔐 Default Impersonated User (View role)
# These values define the default user used for JWTs or impersonation fallback.
# -----------------------------------------------------------------------------

EMAIL=view@test.com
ACCOUNT_TYPE=view
TEAMS=Embed_Users

# Optional testing values (commented out but valid)
# EMAIL=build@test.com
# ACCOUNT_TYPE=build
# TEAMS=Embed_Users

# -----------------------------------------------------------------------------
# 📘 Default Embed Parameters (UI controls)
# These affect how the iframe loads — visible UI, controls, theme, etc.
# -----------------------------------------------------------------------------

disable_auto_refresh=false
disable_mobile_view=true
hide_folder_navigation=true
hide_menu=true
hide_page_controls=true
hide_reload_button=true
hide_title=true
hide_tooltip=false
hide_view_select=true
lng=English
menu_position=bottom
page_id=
responsive_height=false
theme=Lite
view_id=

# -----------------------------------------------------------------------------
# 📒 Workbook Used by `custom_workbook_list` QuickStart
# (Set by element link to be exact in case of reuse)
# -----------------------------------------------------------------------------

WORKBOOK_ID=https://app.sigmacomputing.com/quick-starts-fundamentals/workbook/Copy_create_workbook_API_QuickStart-z4S9zIqUogJPMZcXm5QIS/element/6aAsUkgjW1

